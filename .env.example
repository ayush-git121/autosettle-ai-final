# AI model (either works; ANTHROPIC_API_KEY is preferred when set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# LOVABLE_API_KEY is used automatically on Lovable when ANTHROPIC_API_KEY is empty

# Optional YOLO second detector (see yolo-service/). Leave empty to disable.
YOLO_API_URL=
YOLO_API_KEY=

ADJUSTER_PASSWORD=
